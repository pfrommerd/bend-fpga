# the step from any instruction word
def by_insn(i: Word(16n), +pc: Word(16n), -nzp: Word(3n), -rf: M.Mem<16n>, -mem: M.Mem<16n>) ->
  {S.erase_m(S.step.go(S.Machine{pc, nzp, False{}, rf, mem}, S.retire.go(S.decode(i), pc, nzp, False{}, rf, mem)))
    == S.when(S.step.go(S.Machine{pc, nzp, False{}, rf, mem}, S.retire.go(S.decode(i), pc, nzp, False{}, rf, mem)), C.abs(C.step_with(i, pc, nzp, rf, mem))) : Maybe<&2, S.Machine>}:
  match i:
    case WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, WNil{}}}}}}}}}}}}}}}}}:
      by_bits(b15, b14, b13, b12, b11, b10, b9, b8, b7, b6, b5, b4, b3, b2, b1, b0, pc, nzp, rf, mem)

def Laws.implements_lc4(pc, nzp, rf, mem):
  by_insn(M.get(16n, 16n, pc, mem), pc, nzp, rf, mem)
