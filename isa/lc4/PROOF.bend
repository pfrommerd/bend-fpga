# the privilege bit only flows into the next privilege bit
def priv.exec(i: S.Insn, -pc: Word(16n), -nzp: Word(3n), -priv: Bool, -regs: M.Mem<16n>, -mem: M.Mem<16n>) ->
  {S.erase_m(S.step.go(S.Machine{pc, nzp, priv, regs, mem}, S.retire.go(Some{i}, pc, nzp, priv, regs, mem)))
    == S.erase_m(S.step.go(S.Machine{pc, nzp, False{}, regs, mem}, S.retire.go(Some{i}, pc, nzp, False{}, regs, mem))) : Maybe<&2, S.Machine>}:
  match i:
    case S.BR{n, z, p, off}:
      {==}
    case S.ADD{d, s, t}:
      {==}
    case S.MUL{d, s, t}:
      {==}
    case S.SUB{d, s, t}:
      {==}
    case S.DIV{d, s, t}:
      {==}
    case S.ADDI{d, s, imm}:
      {==}
    case S.CMP{s, t}:
      {==}
    case S.CMPU{s, t}:
      {==}
    case S.CMPI{s, imm}:
      {==}
    case S.CMPIU{s, imm}:
      {==}
    case S.JSRR{s}:
      {==}
    case S.JSR{imm}:
      {==}
    case S.AND{d, s, t}:
      {==}
    case S.NOT{d, s}:
      {==}
    case S.OR{d, s, t}:
      {==}
    case S.XOR{d, s, t}:
      {==}
    case S.ANDI{d, s, imm}:
      {==}
    case S.LDR{d, s, off}:
      {==}
    case S.STR{t, s, off}:
      {==}
    case S.RTI{}:
      {==}
    case S.CONST{d, imm}:
      {==}
    case S.SLL{d, s, amt}:
      {==}
    case S.SRA{d, s, amt}:
      {==}
    case S.SRL{d, s, amt}:
      {==}
    case S.MOD{d, s, t}:
      {==}
    case S.JMPR{s}:
      {==}
    case S.JMP{off}:
      {==}
    case S.HICONST{d, imm}:
      {==}
    case S.TRAP{vec}:
      {==}

def priv.go(mi: Maybe<&2, S.Insn>, -pc: Word(16n), -nzp: Word(3n), -priv: Bool, -regs: M.Mem<16n>, -mem: M.Mem<16n>) ->
  {S.erase_m(S.step.go(S.Machine{pc, nzp, priv, regs, mem}, S.retire.go(mi, pc, nzp, priv, regs, mem)))
    == S.erase_m(S.step.go(S.Machine{pc, nzp, False{}, regs, mem}, S.retire.go(mi, pc, nzp, False{}, regs, mem))) : Maybe<&2, S.Machine>}:
  match mi:
    case None{}:
      {==}
    case Some{i}:
      priv.exec(i, pc, nzp, priv, regs, mem)

def Laws.priv_unobservable(s):
  match s:
    case S.Machine{+pc, nzp, priv, regs, +mem}:
      priv.go(S.decode(M.get(16n, 16n, pc, mem)), pc, nzp, priv, regs, mem)
